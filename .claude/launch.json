{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "magazin-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--", "--port", "5180"],
      "port": 5180,
      "autoPort": false
    },
    {
      "name": "magazin-dev-https",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:https", "--", "--", "--port", "5181"],
      "port": 5181,
      "url": "https://localhost:5181",
      "autoPort": false
    },
    {
      "name": "magazin-netlify-dev",
      "runtimeExecutable": "netlify",
      "runtimeArgs": ["dev", "--port", "5190"],
      "port": 5190,
      "autoPort": false
    },
    {
      "name": "magazin-netlify-serve",
      "runtimeExecutable": "netlify",
      "runtimeArgs": ["serve", "--port", "5191"],
      "port": 5191,
      "autoPort": false
    }
  ]
}
